{
  "name": "ai-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/lending-assistant/vite.config.ts",
    "build": "vite build --config apps/lending-assistant/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "assistant:diagnostics": "node scripts/summarize-assistant-logs.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "5.1.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^22.19.0"
  }
}
