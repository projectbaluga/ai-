{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "vitest/globals",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "workers/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "tests/apply-migrations.ts"
  ]
}
